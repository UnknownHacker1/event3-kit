{
  "name": "Event 3 kit",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "ai.py"] },
    "vscode": { "extensions": ["ms-python.python", "GitHub.copilot", "GitHub.copilot-chat"] }
  },
  "updateContentCommand": "pip install --user -r requirements.txt",
  "portsAttributes": { "8501": { "label": "Dashboard", "onAutoForward": "openPreview" } },
  "forwardPorts": [8501]
}
