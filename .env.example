# Copy this file to .env, then paste your keys after the = signs. No quotes, no spaces.

# Event 3: your free AI key from aistudio.google.com/apikey
GEMINI_API_KEY=

# Event 2: Plaid SANDBOX keys (dashboard.plaid.com > Developers > Keys). Optional today.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Optional: set BANK=csv to always use the fake CSV bank (needed for the Silver test set).
BANK=
